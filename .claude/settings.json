{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          { "type": "command", "command": "cat \"$CLAUDE_PROJECT_DIR/.claude/PROGRESS.md\" 2>/dev/null || true" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "uv run --no-project python \"$CLAUDE_PROJECT_DIR/.checks/boundaries.py\" >/dev/null || exit 2" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.checks/stop-hook.sh\"" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(sudo apt install:*)",
      "Bash(sudo apt update:*)",
      "Bash(python3:*)",
      "Bash(.venv/bin/python3:*)",
      "Bash(.venv/bin/pytest:*)",
      "Bash(uv:*)",
      "Bash(echo:*)",
      "Bash(ls:*)",
      "Bash(jq:*)",
      "Bash(curl:*)",
      "Skill(wrapup)",
      "Skill(wrapup:*)"
    ],
    "additionalDirectories": ["/tmp"]
  },
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "model": "opus",
  "effortLevel": "xhigh"
}
