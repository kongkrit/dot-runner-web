# Temp space: the study plans' working folders; only the placeholder is tracked
.temp/*
!.temp/.placeholder

# Python (uv)
__pycache__/
*.py[cod]
.venv/

# Editor / IDE (.vscode/settings.json is tracked: shared workspace settings)
.idea/
*.swp
*.swo

# Claude Code: track project settings.json; keep personal local settings untracked
.claude/settings.local.json

# Output artefacts (keep sources, ignore generated)
output/
exports/
*.tmp
